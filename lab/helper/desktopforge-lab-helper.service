[Unit]
Description=DesktopForge VM-lab helper (built-in lab recipes only)

[Service]
Type=dbus
BusName=org.desktopforge.LabHelper1
ExecStart=/usr/bin/python3 -Is /usr/local/libexec/desktopforge-lab/desktopforge-lab-helper
# Root UID is needed only so Polkit accepts checks for another subject.
# No capabilities or network; writable: its state directory, the session
# directory and /etc/desktopforge. Package transactions run as a separate
# transient unit started through systemd with a fixed DNF5 command line.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0022
StateDirectory=desktopforge-lab
StateDirectoryMode=0755
ReadWritePaths=/usr/share/wayland-sessions
ConfigurationDirectory=desktopforge
ConfigurationDirectoryMode=0755
