<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- DesktopForge VM-lab helper. Disposable guest only. -->
<policyconfig>
  <vendor>DesktopForge lab</vendor>
  <action id="org.desktopforge.lab.install-session">
    <description>Install packages and add a DesktopForge lab login session</description>
    <message>Authentication is required to install the reviewed Fedora packages and add a new DesktopForge login session. Your existing desktop and login screen settings are not changed.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
