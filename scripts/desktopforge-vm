#!/usr/bin/python3
"""Control the prepared, disposable local VM; never install host packages."""
import argparse
import hashlib
import functools
import http.server
import json
import os
import re
from pathlib import Path
import socket
import stat
import ssl
import time
import subprocess
import threading

ROOT = Path(__file__).resolve().parents[1] / '.desktopforge-vm'
RUN = ROOT / 'run'
SEED = ROOT / 'seed'
SSH_PORT = 22220
USE_TLS = False
QMP_PORT = 22222
PROFILE = 'default'
# Each profile has its own disk, seed, ports, logs and backups. kvm and sddm use the
# mutual-TLS console so both collaborating accounts can control them.
PROFILES = {
    'default': {'run': 'run', 'seed': 'seed', 'ssh': 22220, 'qmp': 22222, 'tls': False, 'name': 'desktopforge-fedora45'},
    'kvm': {'run': 'run-kvm', 'seed': 'seed-kvm', 'ssh': 22221, 'qmp': 22222, 'tls': True, 'name': 'desktopforge-fedora45'},
    'sddm': {'run': 'run-sddm', 'seed': 'seed-kvm', 'ssh': 22231, 'qmp': 22232, 'tls': True,
             'name': 'desktopforge-fedora45-sddm'},
}


def qmp(command, arguments=None):
    if USE_TLS:
        tls = RUN / 'tls'
        context = ssl.create_default_context(cafile=str(tls / 'ca-cert.pem'))
        context.load_cert_chain(str(tls / 'client-cert.pem'), str(tls / 'client-key.pem'))
        client = context.wrap_socket(socket.create_connection(('127.0.0.1', QMP_PORT), timeout=10),
                                     server_hostname='127.0.0.1')
    else:
        path = RUN / 'qmp.sock'
        info = path.lstat()
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
            raise RuntimeError('VM control socket is not owned by this account')
        client = socket.socket(socket.AF_UNIX)
        client.settimeout(10)
        client.connect(str(path))
    with client:
        with client.makefile('rwb', buffering=0) as stream:
            json.loads(stream.readline())
            for name, args in [('qmp_capabilities', None), (command, arguments)]:
                request = {'execute': name}
                if args is not None:
                    request['arguments'] = args
                stream.write((json.dumps(request) + '\n').encode())
                while True:
                    result = json.loads(stream.readline())
                    if 'event' not in result:
                        break
                if 'error' in result:
                    raise RuntimeError(str(result['error']))
            return result['return']


def is_running():
    """True when the profile's control endpoint answers; refused means stopped."""
    if not USE_TLS and not (RUN / 'qmp.sock').exists():
        return False
    try:
        qmp('query-status')
    except (ConnectionRefusedError, FileNotFoundError):
        return False
    return True


BACKUP_NAME = re.compile(r'[a-z0-9][a-z0-9._-]{0,63}')


def backup_dir():
    return ROOT / ('backups' if PROFILE == 'default' else f'backups-{PROFILE}')


def backup_paths(name):
    if not BACKUP_NAME.fullmatch(name or '') or '..' in name:
        raise ValueError('Backup name must be 1-64 of [a-z0-9._-], starting alphanumeric')
    folder = backup_dir()
    return folder / f'{name}.qcow2', folder / f'{name}.json'


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, 'rb') as stream:
        while chunk := stream.read(1 << 22):
            digest.update(chunk)
    return digest.hexdigest()


def clone(source, destination):
    """Copy-on-write clone where supported; never overwrite an existing file."""
    if destination.exists() or destination.is_symlink():
        raise RuntimeError(f'Refusing to overwrite {destination.name}')
    subprocess.run(['cp', '--reflink=auto', '--sparse=always', '--no-dereference',
                    '--', str(source), str(destination)], check=True)


def require_stopped():
    if is_running():
        raise RuntimeError('Stop the VM and wait for QEMU to exit before copying its disk')


def backup(name):
    require_stopped()
    disk, manifest = backup_paths(name)
    folder = backup_dir()
    folder.mkdir(mode=0o700, exist_ok=True)
    if folder.is_symlink() or folder.stat().st_uid != os.getuid():
        raise RuntimeError('Backup directory is not owned by this account')
    source = RUN / 'guest.qcow2'
    if manifest.exists():
        raise RuntimeError(f'Backup {name} already exists')
    clone(source, disk)
    expected, actual = sha256_file(source), sha256_file(disk)
    if expected != actual:
        disk.unlink()
        raise RuntimeError('Backup verification failed; partial copy removed')
    record = {'name': name, 'sha256': actual, 'size': disk.stat().st_size,
              'created': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
              'profile': PROFILE}
    with open(manifest, 'x') as stream:
        json.dump(record, stream, indent=2)
    print(json.dumps(record, indent=2))


def restore(name):
    require_stopped()
    disk, manifest = backup_paths(name)
    if not manifest.is_file() or not disk.is_file() or disk.is_symlink():
        raise RuntimeError(f'No complete backup named {name}')
    record = json.loads(manifest.read_text())
    if sha256_file(disk) != record['sha256']:
        raise RuntimeError(f'Backup {name} does not match its recorded hash; not restoring')
    target = RUN / 'guest.qcow2'
    staging = RUN / 'guest.qcow2.restore'
    if staging.exists():
        staging.unlink()
    clone(disk, staging)
    if sha256_file(staging) != record['sha256']:
        staging.unlink()
        raise RuntimeError('Restored copy failed verification; working disk unchanged')
    os.replace(staging, target)
    print(f'Restored {name} ({record["sha256"]}) to the working disk.')


def list_backups():
    folder = backup_dir()
    records = []
    for manifest in sorted(folder.glob('*.json')) if folder.is_dir() else []:
        records.append(json.loads(manifest.read_text()))
    print(json.dumps(records, indent=2))


def qemu_args(accelerator, show, gl, seed_port):
    """QEMU command line. gl=True gives the guest a virgl 3D GPU (virtio-vga-gl);
    compositors such as Niri refuse software-only rendering, GNOME does not."""
    if gl:
        display = ['-device', 'virtio-vga-gl', '-display', 'gtk,gl=on' if show else 'egl-headless']
        if not show:
            # egl-headless keeps a readable framebuffer only for a 2D listener; a VNC
            # server on a private Unix socket (0700 lab directory) makes screendump work.
            display += ['-vnc', f'unix:{RUN}/vnc.sock']
    else:
        display = ['-device', 'virtio-vga', '-display', 'gtk,gl=off' if show else 'none']
    args = ['qemu-system-x86_64', '-name', PROFILES[PROFILE]['name'], '-machine', f'q35,accel={accelerator}',
            '-cpu', 'host' if accelerator == 'kvm' else 'max', '-smp', '2', '-m', '4096',
            '-drive', f'file={RUN}/guest.qcow2,format=qcow2,if=virtio',
            '-netdev', f'user,id=network0,hostfwd=tcp:127.0.0.1:{SSH_PORT}-:22',
            '-device', 'virtio-net-pci,netdev=network0', *display,
            '-device', 'virtio-rng-pci', '-serial', f'file:{RUN}/serial.log',
            '-smbios', f'type=1,serial=ds=nocloud;s=http://10.0.2.2:{seed_port}/']
    # A guest reboot resets in place; QEMU exits only on guest poweroff or quit.
    if USE_TLS:
        args += ['-object', f'tls-creds-x509,id=console-tls,endpoint=server,dir={RUN}/tls,verify-peer=on',
                 '-chardev', f'socket,id=console,host=127.0.0.1,port={QMP_PORT},server=on,wait=off,tls-creds=console-tls',
                 '-mon', 'chardev=console,mode=control']
    else:
        args += ['-qmp', f'unix:{RUN / "qmp.sock"},server=on,wait=off']
    return args


def start(accelerator, show=False, gl=False):
    kvm_available = os.access('/dev/kvm', os.R_OK | os.W_OK)
    if accelerator == 'auto':
        accelerator = 'kvm' if kvm_available else 'tcg'
    if accelerator == 'kvm' and not kvm_available:
        raise RuntimeError('KVM requested, but /dev/kvm is not accessible to this account/session')
    for path in (RUN / 'guest.qcow2', ROOT / 'keys/id_ed25519', SEED / 'user-data', SEED / 'meta-data', RUN / 'image-verification.json'):
        if not path.is_file():
            raise RuntimeError('VM has not been prepared: missing ' + str(path))
    path = RUN / 'qmp.sock'
    if is_running():
        raise RuntimeError('VM is already running')
    if not USE_TLS and path.exists():
        path.unlink()
    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=str(SEED))
    server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    port = server.server_address[1]
    args = qemu_args(accelerator, show, gl, port)
    try:
        with (RUN / 'qemu.log').open('ab') as log:
            print(f'Starting disposable guest ({accelerator}); SSH on 127.0.0.1:{SSH_PORT}', flush=True)
            process = subprocess.Popen(args, cwd=ROOT.parent, stdin=subprocess.DEVNULL, stdout=log, stderr=log)
            try:
                if USE_TLS:
                    # Resize only this disposable disk, before first-boot growpart runs.
                    for attempt in range(100):
                        if process.poll() is not None:
                            raise RuntimeError('QEMU exited during startup; inspect the private qemu.log')
                        try:
                            blocks = qmp('query-block')
                            disk = next(b for b in blocks if b.get('inserted', {}).get('drv') == 'qcow2')
                            if disk['inserted']['image']['virtual-size'] < 16 * 1024**3:
                                qmp('block_resize', {'device': disk['device'], 'size': 16 * 1024**3})
                            break
                        except ConnectionRefusedError:
                            time.sleep(0.1)
                    else:
                        process.terminate()
                        process.wait()
                        raise RuntimeError('Console did not become available during startup')
            except Exception:
                process.terminate()
                process.wait(timeout=10)
                raise
            while True:
                try:
                    return process.wait(timeout=30)
                except subprocess.TimeoutExpired:
                    print('VM supervisor active; guest console and SSH remain available when booted.', flush=True)
    finally:
        server.shutdown()


def select_profile(name):
    global RUN, SEED, SSH_PORT, USE_TLS, QMP_PORT, PROFILE
    profile = PROFILES[name]
    PROFILE = name
    RUN, SEED = ROOT / profile['run'], ROOT / profile['seed']
    SSH_PORT, QMP_PORT, USE_TLS = profile['ssh'], profile['qmp'], profile['tls']


def main():
    global RUN, SEED, SSH_PORT, USE_TLS, QMP_PORT, PROFILE
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--accelerator', choices=('auto', 'tcg', 'kvm'), default='auto',
                        help='Start mode; auto uses accessible KVM, otherwise software emulation')
    parser.add_argument('--show', action='store_true', help='Show the guest in a QEMU window')
    parser.add_argument('--gl', action='store_true',
                        help='Give the guest a virgl 3D GPU using host OpenGL (needed for Niri)')
    parser.add_argument('--profile', choices=sorted(PROFILES), default='default')
    parser.add_argument('action', choices=('start', 'status', 'ssh', 'screenshot', 'stop', 'backup', 'restore', 'backups'))
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    select_profile(args.profile)
    if not ROOT.is_dir() or ROOT.is_symlink() or ROOT.stat().st_uid != os.getuid():
        parser.error('Private VM state directory is missing or not owned by this account')
    if args.action == 'start':
        return start(args.accelerator, args.show, args.gl)
    if args.action in ('backup', 'restore'):
        if len(args.command) != 1:
            parser.error(f'{args.action} requires exactly one backup name')
        (backup if args.action == 'backup' else restore)(args.command[0])
        return 0
    if args.action == 'backups':
        list_backups()
        return 0
    if args.action == 'ssh':
        return subprocess.call(['ssh', '-F', '/dev/null', '-i', str(ROOT / 'keys/id_ed25519'),
            '-p', str(SSH_PORT), '-o', 'IdentitiesOnly=yes', '-o', 'BatchMode=yes',
            '-o', 'ConnectTimeout=10', '-o', 'StrictHostKeyChecking=accept-new',
            '-o', f'UserKnownHostsFile={ROOT}/keys/known_hosts', 'dfvm@127.0.0.1', *args.command])
    if args.action == 'status':
        print(json.dumps(qmp('query-status'), indent=2))
    elif args.action == 'stop':
        # Graceful guest shutdown. No PID-based kill and no forced disk teardown.
        qmp('system_powerdown')
        print('Requested graceful guest shutdown.')
    elif args.action == 'screenshot':
        destination = RUN / 'screen.ppm'
        # The two collaborating accounts may see different bind-mount prefixes.
        # QEMU's cwd is fixed to the checkout; a relative path works for both.
        server_path = str(destination.relative_to(ROOT.parent)) if USE_TLS else str(destination)
        qmp('screendump', {'filename': server_path})
        print(destination)
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError) as exc:
        raise SystemExit(str(exc))
