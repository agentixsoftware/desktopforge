#!/usr/bin/python3 -Is
"""DesktopForge VM-lab helper: the shared daemon (src/desktopforge/helperd/daemon.py)
run with the lab profile (lab bus name, lab Polkit actions, lab recipes).

Installed, it loads only the root-owned copy under /usr/local/lib/desktopforge-lab;
from a checkout (tests) it loads the repository source.
"""
import os
import runpy
import sys

INSTALLED = '/usr/local/lib/desktopforge-lab/python/desktopforge/helperd/daemon.py'
_here = os.path.dirname(os.path.abspath(__file__))
_source = (INSTALLED if _here.startswith('/usr/local/libexec/')
           else os.path.join(_here, '..', '..', 'src', 'desktopforge', 'helperd', 'daemon.py'))
globals().update({k: v for k, v in runpy.run_path(_source, init_globals={'PROFILE_NAME': 'lab'},
                                                    run_name='desktopforge_lab_daemon').items()
                  if not k.startswith('__')})

if __name__ == '__main__':
    sys.exit(run_service())  # noqa: F821 - provided by the daemon namespace above
