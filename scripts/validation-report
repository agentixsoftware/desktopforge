#!/usr/bin/python3
"""Report what a recipe's validation evidence supports right now.

Usage: scripts/validation-report validation/<recipe-id>/r<revision>.json [--require lab-validated|approvable]

Fingerprints the recipe as currently defined, and asks git whether the helper,
launcher or template code changed since each case's commit (such cases are
stale). Exits 1 if the evidence does not reach the required tier.
"""
import argparse
import json
from pathlib import Path
import runpy
import subprocess
import sys

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / 'src'))
from desktopforge import validation  # noqa: E402

TIERS = ('not-validated', 'lab-validated', 'approvable')


def changed_since(commit):
    result = subprocess.run(['git', '-C', str(REPO), 'diff', '--quiet', commit, 'HEAD', '--', *validation.CODE_PATHS],
                            capture_output=True)
    if result.returncode not in (0, 1):
        return True  # unknown commit: cannot prove the case is current
    return result.returncode == 1


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('evidence')
    parser.add_argument('--require', choices=TIERS[1:])
    args = parser.parse_args()
    evidence = json.loads(Path(args.evidence).read_text())
    daemon = runpy.run_path(str(REPO / 'src/desktopforge/helperd/daemon.py'), init_globals={'PROFILE_NAME': 'lab'},
                            run_name='validation_report')
    recipe = daemon['ALL_RECIPES'][evidence['recipe']['id']]
    if recipe['revision'] != evidence['recipe']['revision']:
        sys.exit(f'evidence is for revision {evidence["recipe"]["revision"]}, recipe is at {recipe["revision"]}')
    templates = {p.name: p.read_text() for p in (REPO / 'src/desktopforge/data/templates').glob('*')}
    current = validation.fingerprint(recipe, daemon['SESSION_LAUNCHER'], templates)
    report = validation.assess(evidence, current, changed_since)
    print(f"recipe {evidence['recipe']['id']} r{evidence['recipe']['revision']}: {report['tier']}")
    print(f"  fingerprint {'matches' if report['fingerprint_matches'] else 'DIFFERS (recipe changed)'}: {current}")
    for key, label in (('failed', 'failed'), ('stale', 'stale (code changed since the run)'),
                       ('missing_lab', 'lab cases still needed'), ('missing_hardware', 'hardware cases still needed')):
        if report[key]:
            print(f'  {label}: ' + ', '.join(report[key]))
    if args.require and TIERS.index(report['tier']) < TIERS.index(args.require):
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
