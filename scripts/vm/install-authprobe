#!/usr/bin/python3 -Is
"""Install or remove the lab authorization probe inside the disposable VM only.

Copies reviewed files from lab/authprobe into fixed root-owned locations so the
system service never runs from a user-writable checkout. Refuses to run outside
the dedicated guest. Not a production installer.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import tempfile

GUEST_HOSTNAME = 'desktopforge-fedora45'
SOURCE = Path(__file__).resolve().parents[2] / 'lab/authprobe'
FILES = {  # source name -> (destination, mode)
    'desktopforge-lab-authprobe': ('/usr/local/libexec/desktopforge-lab/desktopforge-lab-authprobe', 0o755),
    'desktopforge-lab-authprobe.service': ('/etc/systemd/system/desktopforge-lab-authprobe.service', 0o644),
    'org.desktopforge.LabAuthProbe1.conf': ('/etc/dbus-1/system.d/org.desktopforge.LabAuthProbe1.conf', 0o644),
    'org.desktopforge.LabAuthProbe1.service': ('/usr/share/dbus-1/system-services/org.desktopforge.LabAuthProbe1.service', 0o644),
    'org.desktopforge.lab.authprobe.policy': ('/usr/share/polkit-1/actions/org.desktopforge.lab.authprobe.policy', 0o644),
}
OWNED_DIRECTORY = Path('/usr/local/libexec/desktopforge-lab')


def read_reviewed(name):
    path = SOURCE / name
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode):
        raise SystemExit(f'{path} is not a regular file')
    return path.read_bytes()


def install():
    records = []
    OWNED_DIRECTORY.mkdir(mode=0o755, exist_ok=True)
    os.chown(OWNED_DIRECTORY, 0, 0)
    for name, (destination, mode) in FILES.items():
        data = read_reviewed(name)
        target = Path(destination)
        if target.is_symlink():
            raise SystemExit(f'Refusing symlinked destination {target}')
        # Write a root-owned temporary file beside the target, then rename.
        fd, temporary = tempfile.mkstemp(dir=target.parent, prefix='.dflab-')
        try:
            os.fchown(fd, 0, 0)
            os.fchmod(fd, mode)
            os.write(fd, data)
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(temporary, target)
        subprocess.run(['restorecon', str(target)], check=False)
        records.append({'path': destination, 'mode': oct(mode), 'sha256': hashlib.sha256(data).hexdigest()})
    reload()
    print(json.dumps(records, indent=2))


def uninstall():
    subprocess.run(['systemctl', 'stop', 'desktopforge-lab-authprobe.service'], check=False)
    for destination, _mode in FILES.values():
        Path(destination).unlink(missing_ok=True)
    if OWNED_DIRECTORY.is_dir() and not OWNED_DIRECTORY.is_symlink():
        shutil.rmtree(OWNED_DIRECTORY)
    reload()
    print('Removed the lab authorization probe.')


def reload():
    subprocess.run(['systemctl', 'daemon-reload'], check=True)
    subprocess.run(['busctl', 'call', 'org.freedesktop.DBus', '/org/freedesktop/DBus',
                    'org.freedesktop.DBus', 'ReloadConfig'], check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--uninstall', action='store_true')
    args = parser.parse_args()
    if Path('/etc/hostname').read_text().strip() != GUEST_HOSTNAME:
        parser.error('Run only in the dedicated disposable VM')
    if os.geteuid() != 0:
        parser.error('Run with guest sudo inside the disposable VM')
    uninstall() if args.uninstall else install()


if __name__ == '__main__':
    main()
